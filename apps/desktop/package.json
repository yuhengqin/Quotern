{
  "name": "quotern-desktop",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "description": "Quotern 统计客户端：Token 用量明细追踪，本地采集与统计面板。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuhengqin/Quotern.git",
    "directory": "apps/desktop"
  },
  "scripts": {
    "dev": "node scripts/run-tauri.mjs dev",
    "build": "node scripts/run-tauri.mjs build",
    "start": "node scripts/run-tauri.mjs start",
    "bundle": "node scripts/run-tauri.mjs bundle",
    "build:mac": "node ../../scripts/release-macos.mjs --mode adhoc",
    "build:mac:signed": "node ../../scripts/release-macos.mjs --mode signed",
    "build:mac:arm": "node ../../scripts/release-macos.mjs --mode adhoc --arch arm64 --build-only",
    "build:win": "node ../../scripts/release-windows.mjs",
    "release:mac": "corepack pnpm build:mac",
    "release:mac:signed": "corepack pnpm build:mac:signed",
    "release:win": "corepack pnpm build:win",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test scripts/prepare-native-runtime.test.mjs scripts/prepare-dsh-pet.test.mjs scripts/dsh-pet-controls.test.mjs scripts/dsh-pet-interactions.test.mjs scripts/dsh-pet-position-store.test.mjs scripts/prepare-tauri-node.test.mjs && node -e \"require('node:fs').rmSync('dist-test', { recursive: true, force: true })\" && tsc -p tsconfig.test.json && node scripts/prepare-desktop-tests.mjs && node --test \"dist-test/**/*.test.js\""
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@gravity-ui/icons": "^2.20.0",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@internationalized/date": "3.12.3",
    "@lobehub/icons": "^5.18.0",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@nivo/heatmap": "^0.99.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/history": "^1.162.0",
    "@tanstack/react-router": "^1.170.18",
    "@tauri-apps/api": "2.12.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.24.0",
    "quotern-core": "workspace:*",
    "quotern-i18n": "workspace:*",
    "react": "^19.0.0",
    "react-aria": "3.51.0",
    "react-aria-components": "1.20.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "vscode-jsonrpc": "10.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.20",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.10",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.25.12",
    "playwright-core": "1.61.1",
    "typescript": "^5.9.3",
    "vite": "^6.2.2"
  }
}
