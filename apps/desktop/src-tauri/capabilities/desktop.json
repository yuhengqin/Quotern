{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Receive application events in the local Quotern windows.",
  "windows": ["main", "tray", "pet", "dsh-pet", "reference-*"],
  "permissions": ["allow-desktop-request", "core:event:allow-listen", "core:event:allow-unlisten", "core:window:allow-start-dragging", "core:window:allow-toggle-maximize"]
}
