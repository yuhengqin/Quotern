{
  "name": "quotern-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuhengqin/Quotern.git"
  },
  "bugs": {
    "url": "https://github.com/yuhengqin/Quotern/issues"
  },
  "homepage": "https://github.com/yuhengqin/Quotern#readme",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/**\" -r build",
    "build:cli": "pnpm --filter quotern... build",
    "test": "pnpm test:release && pnpm test:upstream-contracts && pnpm test:state-migration && pnpm test:run-parallel && pnpm test:dev-instance && pnpm test:localization-catalogs && pnpm build && pnpm test:dev-runtime && pnpm test:vite-core-source && pnpm -r --if-present test",
    "test:release": "node --test scripts/macos-release-policy.test.mjs scripts/release-artifacts.test.mjs scripts/release-macos.test.mjs scripts/check-source-archive.test.mjs scripts/release-workflow.test.mjs scripts/npm-release.test.mjs",
    "check:npm-release": "node scripts/npm-release.mjs",
    "check:source-archive": "node scripts/check-source-archive.mjs",
    "verify:desktop:win": "node scripts/release-artifacts.mjs verify --platform win",
    "verify:desktop:mac": "node scripts/release-macos.mjs --skip-build --mode adhoc",
    "verify:desktop:mac:signed": "node scripts/release-macos.mjs --skip-build --mode signed",
    "assemble:desktop": "node scripts/release-artifacts.mjs assemble",
    "test:upstream-contracts": "node --test scripts/check-upstream-contracts.test.mjs",
    "check:upstream-contracts": "node scripts/check-upstream-contracts.mjs",
    "test:state-migration": "node --test scripts/migrate-state.test.mjs",
    "test:run-parallel": "node --test scripts/run-parallel.test.mjs",
    "test:dev-instance": "node --test scripts/dev-instance.test.mjs",
    "test:localization-catalogs": "node --experimental-strip-types --test scripts/localization-catalogs.test.mjs",
    "test:dev-runtime": "node --test scripts/dev-runtime.test.mjs",
    "test:vite-core-source": "node --test scripts/vite-core-source.test.mjs",
    "start": "pnpm start:cli",
    "start:cli": "pnpm build:cli && pnpm --filter quotern start",
    "dev:cli": "node scripts/dev.mjs cli",
    "dev:cli:api": "node scripts/dev.mjs api",
    "dev:cli:ui": "node scripts/dev.mjs ui",
    "dev:status": "node scripts/dev.mjs status",
    "sync": "pnpm --filter quotern sync",
    "sync:pricing": "pnpm --filter quotern-core sync:pricing",
    "dev:dashboard": "node scripts/dev.mjs ui",
    "start:dashboard": "pnpm --filter quotern-dashboard preview",
    "dev:desktop": "node scripts/dev.mjs desktop",
    "dev:desktop:quota": "cross-env QUOTERN_DEV_QUOTA_PREVIEW=1 node scripts/dev.mjs desktop",
    "build:desktop": "pnpm --filter quotern-desktop... build",
    "build:desktop:mac": "pnpm --filter \"quotern-desktop^...\" build && pnpm --filter quotern-desktop build:mac",
    "build:desktop:mac:signed": "pnpm --filter \"quotern-desktop^...\" build && pnpm --filter quotern-desktop build:mac:signed",
    "build:desktop:mac:arm": "pnpm --filter \"quotern-desktop^...\" build && pnpm --filter quotern-desktop build:mac:arm",
    "build:desktop:win": "pnpm --filter \"quotern-desktop^...\" build && pnpm --filter quotern-desktop build:win",
    "release:desktop:mac": "pnpm --filter \"quotern-desktop^...\" build && pnpm --filter quotern-desktop release:mac",
    "release:desktop:mac:signed": "pnpm --filter \"quotern-desktop^...\" build && pnpm --filter quotern-desktop release:mac:signed",
    "release:desktop:win": "pnpm --filter \"quotern-desktop^...\" build && pnpm --filter quotern-desktop release:win",
    "start:desktop": "pnpm --filter \"quotern-desktop^...\" build && pnpm --filter quotern-desktop start",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:cli && changeset publish"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.20.1",
    "cross-env": "^10.1.0",
    "js-yaml": "4.1.1",
    "typescript": "^5.9.3"
  }
}
