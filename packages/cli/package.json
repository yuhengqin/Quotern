{
  "name": "quotern",
  "version": "0.1.13",
  "description": "Quotern CLI：Coding Agent 用量、额度与费用的统一入口。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuhengqin/Quotern.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/yuhengqin/Quotern/issues"
  },
  "homepage": "https://github.com/yuhengqin/Quotern#readme",
  "keywords": [
    "ai",
    "token",
    "usage",
    "claude",
    "codex",
    "cursor",
    "cli"
  ],
  "bin": {
    "quotern": "./bin/quotern.js"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-dashboard.mjs",
    "start": "node ./bin/quotern.js start",
    "sync": "node ./bin/quotern.js sync",
    "status": "node ./bin/quotern.js status",
    "service": "node ./bin/quotern.js service",
    "test": "tsc -p tsconfig.json && node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "quotern-core": "workspace:*",
    "quotern-i18n": "workspace:*",
    "zod": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "quotern-dashboard": "workspace:*",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
